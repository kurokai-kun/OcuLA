# Auto detect text files and normalize line endings
* text=auto

# Text files
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.py text eol=lf
*.typ text eol=lf
*.svg text eol=lf

# Binary files
*.pdf binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
